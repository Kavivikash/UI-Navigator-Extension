{
  "manifest_version": 3,
  "name": "UI Navigator Agent",
  "version": "1.0",
  "description": "Visual web navigation agent",
  "permissions": ["activeTab", "scripting", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }
]
}
